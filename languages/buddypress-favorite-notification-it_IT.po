#: includes/admin/views/discover.php:27
msgid "A free, fast community theme for BuddyPress, BuddyBoss and PeepSo with a modern layout and dark mode."
msgstr "Un tema comunità gratuito e veloce per BuddyPress, BuddyBoss e PeepSo con un layout moderno e modalità scura."

